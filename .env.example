# 로컬 개발용: 이 파일을 .env.local로 복사해서 값을 채우세요.
# 배포 환경 값은 Vercel 프로젝트 환경변수에 등록합니다.

# Claude API 키 (문자 판정, 키오스크 안내에 필요)
ANTHROPIC_API_KEY=

# 평가 스크립트가 X-Device-Token 헤더로 보내는 토큰 목록 (쉼표로 구분). 앱은 쓰지 않는다. 운영에서는 비워 둔다
DEVICE_TOKENS=dev-token-1

# 문자 판정 모델 설정 (선택, 기본값: claude-opus-5-5 / low)
# MESSAGES_MODEL=claude-opus-5-5
# MESSAGES_EFFORT=low

# 키오스크 안내 모델 설정 (선택, 기본값: claude-opus-5-5 / low)
# KIOSK_MODEL=claude-opus-5-5
# KIOSK_EFFORT=low

# 인터넷 주소 판정 모델 설정 (선택, 기본값: claude-opus-5-5 / low)
# URLS_MODEL=claude-opus-5-5
# URLS_EFFORT=low

# Google Web Risk API 키 (선택). 있으면 Claude보다 먼저 구글의 위험 사이트 목록을 확인합니다.
# WEB_RISK_API_KEY=

# 데이터베이스 (Vercel의 Prisma Postgres 연결 시 자동으로 들어감)
# 로컬에서는 비워 두면 내장 DB(.pglite 폴더)를 씁니다.
# DATABASE_URL=
